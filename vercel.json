{
    "rewrites": [
        {
            "source": "/workspace/:workspaceId",
            "destination": "/api/preview"
        },
        {
            "source": "/join/:inviteCode",
            "destination": "/api/preview"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ],
    "crons": [
        {
            "path": "/api/dispatch-expense-emails",
            "schedule": "*/5 * * * *"
        }
    ]
}